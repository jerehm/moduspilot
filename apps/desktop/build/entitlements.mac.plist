<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT needs these under the hardened runtime required by notarization. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Needed so the app can load its native module (better-sqlite3). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Touch ID passkeys. These three are RESTRICTED: macOS honours them only
       because build/modus-developer-id.provisionprofile is embedded and grants
       them. Without that profile the kernel kills the app at launch (0.3.2 to
       0.4.2 all died this way). scripts/verify-signed-app.js enforces it. The
       keychain group MUST match WEBAUTHN_KEYCHAIN_GROUP in src/main/index.ts. -->
  <key>com.apple.application-identifier</key>
  <string>8KF5J7X9BU.com.moduspilot.desktop</string>
  <key>com.apple.developer.team-identifier</key>
  <string>8KF5J7X9BU</string>
  <key>keychain-access-groups</key>
  <array>
    <string>8KF5J7X9BU.com.moduspilot.desktop.webauthn</string>
  </array>
</dict>
</plist>
