<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT needs these under the hardened runtime required by notarization. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Needed so the app can load its native module (better-sqlite3). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- NO keychain-access-groups. It is a restricted entitlement: on a Developer
       ID app without an embedded provisioning profile the kernel kills the app
       at launch (0.3.2 to 0.4.2 all died this way). scripts/verify-signed-app.js
       enforces it. See the Touch ID note in src/main/index.ts. -->
</dict>
</plist>
