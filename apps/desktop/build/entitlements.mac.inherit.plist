<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT needs these under the hardened runtime required by notarization. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Needed so the app can load its native module (better-sqlite3). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Helper processes. NO profile-backed keys here: those live only in
       entitlements.mac.plist for the main app. -->
</dict>
</plist>
